{
  "name": "repo-canon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node --check operations/*.mjs && node --check scripts/*.mjs && node --check scripts/support/*.mjs && node --check .github/scripts/*.mjs && node --check test/*.test.mjs && node --check test/helpers/*.mjs && node --check test/fixtures/*.mjs",
    "build:scope-proposal": "node scripts/build-scope-proposal.mjs",
    "prepare:adoption-fixtures": "node scripts/prepare-adoption-fixtures.mjs",
    "test": "node --test test/*.test.mjs",
    "test:engineering-skill-fixtures": "node --test test/engineering-skill-fixtures.test.mjs",
    "test:planning-skill-fixtures": "node --test test/planning-skill-fixtures.test.mjs",
    "test:github-pr-integration": "node --test test/github-pr-integration-setup.test.mjs",
    "test:issue-contracts": "node --test test/issue-contracts.test.mjs",
    "test:productivity-skill-fixtures": "node --test test/productivity-skill-fixtures.test.mjs"
  }
}
