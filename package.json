{
  "name": "repo-canon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "check": "for file in operations/*.mjs operations/lib/*.mjs discovery/*.mjs scripts/*.mjs scripts/release/*.mjs scripts/support/*.mjs .github/scripts/*.mjs test/*.test.mjs test/helpers/*.mjs test/fixtures/*.mjs; do node --check \"$file\" || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "release:inputs": "node scripts/release/inputs.mjs",
    "release:check-merge": "node scripts/release/check-merge.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "test:deliver-skill-fixtures": "node --test test/deliver-skill-fixtures.test.mjs",
    "test:engineering-skill-fixtures": "node --test test/engineering-skill-fixtures.test.mjs",
    "test:planning-skill-fixtures": "node --test test/planning-skill-fixtures.test.mjs",
    "test:github-pr-integration": "node --test test/github-pr-integration-setup.test.mjs",
    "test:issue-contracts": "node --test test/issue-contracts.test.mjs",
    "test:productivity-skill-fixtures": "node --test test/productivity-skill-fixtures.test.mjs"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "prettier": "3.9.9"
  }
}
