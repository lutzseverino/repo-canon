{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.mjs", "**/*.js"],
  "exclude": [
    "node_modules",
    ".repo-standards",
    "vendor/marked",
    "vendor/parse5",
    "vendor/postern",
    "vendor/mattpocock-skills",
    "vendor/humanlayer-skills"
  ]
}
